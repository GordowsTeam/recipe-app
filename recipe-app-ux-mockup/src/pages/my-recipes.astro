---
import MainLayout from '../layouts/MainLayout.astro';
import { mockRecipes } from '../data/recipes';
const myRecipes = mockRecipes.slice(0, 3);
---

<MainLayout title="My Recipes - NUMA" isAuthenticated={true}>
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <h1 style="font-size: 1.5rem; margin: 0;">My Recipes</h1>
    <a href="/upload-recipe" class="btn-primary">+ Create new recipe</a>
  </div>
  <div class="recipe-list">
    {myRecipes.map((r) => (
      <a href={`/recipe-detail/${r.id}`} class="recipe-card">
        <div class="img-container">
          <div class="section-card-img-placeholder" style="aspect-ratio: 4/3;">📖</div>
          <div class="title-always-visible">{r.name}</div>
          <div class="badge-container">
            <span class="badge">⏱ {r.totalTime} min</span>
            <span class="badge">🔥 {r.calories} cal</span>
          </div>
        </div>
        <div class="recipe-card-actions">
          <button type="button" aria-label="Favorito"><span class="material-symbols-outlined" style="font-size:20px">favorite</span></button>
          <button type="button" aria-label="Guardar"><span class="material-symbols-outlined" style="font-size:20px">bookmark</span></button>
          <button type="button" aria-label="Compartir"><span class="material-symbols-outlined" style="font-size:20px">share</span></button>
          <button type="button" aria-label="Quitar" style="color: var(--error);"><span class="material-symbols-outlined" style="font-size:20px">remove_circle_outline</span></button>
        </div>
      </a>
    ))}
  </div>
</MainLayout>
