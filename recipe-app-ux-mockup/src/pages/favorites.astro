---
import MainLayout from '../layouts/MainLayout.astro';
import { mockRecipes } from '../data/recipes';
const favorites = mockRecipes.slice(0, 4);
---

<MainLayout title="Favorites - NUMA" isAuthenticated={true}>
  <h1 style="font-size: 1.5rem; margin: 0 0 16px;">Favorites</h1>
  <div class="recipe-list">
    {favorites.map((r) => (
      <a href={`/recipe-detail/${r.id}`} class="recipe-card">
        <div class="img-container">
          <div class="section-card-img-placeholder" style="aspect-ratio: 4/3;">❤️</div>
          <div class="title-always-visible">{r.name}</div>
          <div class="badge-container">
            <span class="badge">⏱ {r.totalTime} min</span>
            <span class="badge">🔥 {r.calories} cal</span>
          </div>
        </div>
        <div class="recipe-card-actions">
          <button type="button" aria-label="Favorito"><span class="material-symbols-outlined" style="font-size:20px">favorite</span></button>
          <button type="button" aria-label="Guardar"><span class="material-symbols-outlined" style="font-size:20px">bookmark</span></button>
          <button type="button" aria-label="Compartir"><span class="material-symbols-outlined" style="font-size:20px">share</span></button>
        </div>
      </a>
    ))}
  </div>
</MainLayout>
