---
// 404 page - no layout to allow full-page styling
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - NUMA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-404">
      <p class="big-404">404</p>
      <p class="sub">Oops. Nothing here...</p>
      <a href="/" class="btn-primary">Go Home</a>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Roboto', sans-serif; }
  .page-404 {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #1976d2;
    color: #fff;
    padding: 24px;
    text-align: center;
  }
  .big-404 { font-size: 30vh; line-height: 1; margin: 0; }
  .sub { font-size: 1.5rem; opacity: 0.8; margin-top: 16px; }
  .btn-primary {
    display: inline-block;
    padding: 12px 24px;
    background: #fff;
    color: #1976d2;
    border-radius: 8px;
    font-size: 1rem;
    text-decoration: none;
    margin-top: 24px;
    font-weight: 600;
  }
  .btn-primary:hover { opacity: 0.95; }
</style>
